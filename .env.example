# PostgreSQL (Neon: use a connection string "pooled" com sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/funnelos

# URL pública da aplicação (usada para montar links das campanhas)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: exige este token na tela /setup (criação do primeiro administrador)
SETUP_TOKEN=

# Usado para gerar hash de IP em registros de consentimento (qualquer string longa e aleatória)
APP_SECRET=troque-por-uma-string-aleatoria-longa
